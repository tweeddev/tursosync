# Copy to .env at the repo root to run the live Turso test suites locally.
# The test project loads this file automatically (DotNetEnv, via EnvLoader.cs).
# Real environment variables always win, so exporting any of these in your shell
# — or in CI — overrides what's here. Leave a line unset to skip that suite
# (its tests report Inconclusive rather than failing).

# --- LiveSyncIntegrationTests: self-hosted `tursodb --sync-server` round-trip ---
# Path to a `tursodb` binary. The harness spins one up on a free port per test.
TURSOSYNC_SYNC_SERVER=/path/to/tursodb

# --- TursoSyncBehaviorTests: real Turso Cloud round-trip ---
# A sync-enabled database URL and its auth token.
TURSOSYNC_SYNC_URL=libsql://your-db.turso.io
TURSOSYNC_SYNC_TOKEN=your-token
